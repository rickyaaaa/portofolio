---
/**
 * Shell for ad landing pages (/konsultasi).
 *
 * Deliberately separate from BaseLayout: there is no header, nav, footer,
 * WhatsApp bubble, preloader, jQuery, GSAP or Agenko CSS here. A landing page
 * for paid traffic should only offer one exit, the form, and the main site's
 * stack (about 20 render-blocking files) would cost the mobile Lighthouse
 * score this page is built for.
 *
 * Styling is plain CSS: design tokens in the global block below, and each
 * landing component carries its own scoped <style>. The project has no
 * Tailwind, and adding a build dependency for one page was not worth it.
 */
import { PIXEL_ENABLED, PIXEL_ID } from '../data/landing';
import { asset } from '../lib/asset';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Under `format: 'file'` the pathname is /konsultasi.html; the server serves
// the extensionless form, so that is the URL a link preview should show.
const pageUrl = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site).href;
// Absolute, because link previews are fetched by other servers.
const ogImage = new URL('/assets/images/ricksite/pages/ricksite-og.jpg', Astro.site).href;

const pixelId = PIXEL_ID;

// Poppins is the brand face (the logo wordmark is set in it). Loaded without
// blocking render; see the "Poppins Fallback" face below for why that does not
// cause a layout shift when it swaps in.
const fontHref =
  'https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap';
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Ad landing page: keep it out of search results and the link graph. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0d0d0d" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ricksite Studio" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <link rel="icon" href={asset('/assets/images/ricksite/logo/ricksite-appicon.svg')} type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Non-blocking stylesheet: applies once loaded, never holds up first paint. -->
    <link rel="stylesheet" href={fontHref} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fontHref} /></noscript>

    {PIXEL_ENABLED && (
      <link rel="preconnect" href="https://connect.facebook.net" />
    )}

    {/*
      Meta Pixel. is:inline (implied by define:vars) so Astro emits it as
      written instead of bundling it. Only rendered once PIXEL_ID in
      src/data/landing.ts holds a real ID.
      TODO: PIXEL_ID - set it in src/data/landing.ts, not here.
    */}
    {PIXEL_ENABLED && (
      <script is:inline define:vars={{ pixelId }}>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
        document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId);
        fbq('track', 'PageView');
      </script>
    )}
    {PIXEL_ENABLED && (
      <noscript>
        <img
          height="1"
          width="1"
          style="display:none"
          alt=""
          src={`https://www.facebook.com/tr?id=${PIXEL_ID}&ev=PageView&noscript=1`}
        />
      </noscript>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /*
   * Fallback face metric-matched to Poppins (same numbers next/font and
   * fontaine generate). Text first renders in Arial stretched to Poppins'
   * width and line height, so when Poppins arrives the lines do not rewrap
   * and nothing below them moves.
   */
  @font-face {
    font-family: 'Poppins Fallback';
    src: local('Arial');
    ascent-override: 93.62%;
    descent-override: 31.21%;
    line-gap-override: 8.92%;
    size-adjust: 112.16%;
  }

  /*
   * Design tokens.
   * TODO: warna brand - these follow the Ricksite brand (logo ink + accent
   * green from public/assets/css/ricksite.css). Change them here only.
   */
  :root {
    --ink: #0d0d0d; /* brand ink: hero, dark cards, primary buttons */
    --ink-soft: #1c1c1a;
    --lime: #b6f24b; /* brand accent: highlights on dark surfaces */
    --paper: #ffffff;
    --sand: #f6f5f0; /* alternate section background */
    --line: #e3e1d9;
    --text: #1a1a18;
    --muted: #55544e; /* 7.4:1 on white */
    --on-dark: #f4f4f1;
    --on-dark-muted: #b9b8b1; /* 9.6:1 on --ink */
    --wa: #25d366; /* WhatsApp green: form submit button ONLY */
    --wa-hover: #1ebe5b;
    --danger: #b42318; /* 6.5:1 on white */
    --danger-bg: #fef3f2;

    --radius: 14px;
    --radius-sm: 10px;
    --shadow: 0 1px 2px rgba(13, 13, 13, 0.06), 0 8px 24px rgba(13, 13, 13, 0.06);
    --wrap: 1120px;
    --gutter: 20px;
    --section-y: 72px;

    --font: 'Poppins', 'Poppins Fallback', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
  }

  @media (min-width: 768px) {
    :root {
      --gutter: 32px;
      --section-y: 104px;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--text);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    /* Room for the mobile sticky CTA, reserved up front so it never shifts. */
    padding-bottom: 84px;
  }

  @media (min-width: 768px) {
    body {
      padding-bottom: 0;
    }
  }

  h1,
  h2,
  h3,
  p,
  ul,
  ol,
  figure {
    margin: 0;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  img {
    height: auto;
  }

  a {
    color: inherit;
  }

  button,
  input {
    font: inherit;
    color: inherit;
  }

  :focus-visible {
    outline: 3px solid #2563eb;
    outline-offset: 3px;
  }

  .lp-wrap {
    width: 100%;
    max-width: var(--wrap);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .lp-section {
    padding-block: var(--section-y);
  }

  .lp-section--sand {
    background: var(--sand);
  }

  .lp-eyebrow {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .lp-h2 {
    font-size: clamp(26px, 6.4vw, 38px);
    line-height: 1.22;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--ink);
    max-width: 22ch;
    text-wrap: balance;
  }

  .lp-lead {
    margin-top: 14px;
    font-size: 17px;
    color: var(--muted);
    max-width: 58ch;
  }

  .lp-head {
    margin-bottom: 40px;
  }

  /* Primary (non-WhatsApp) call to action. Brand ink, never WhatsApp green. */
  .lp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 56px;
    padding: 14px 26px;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .lp-btn:hover {
    background: var(--ink-soft);
  }

  .lp-btn:active {
    transform: translateY(1px);
  }

  /* Accent variant for dark surfaces. */
  .lp-btn--lime {
    background: var(--lime);
    color: var(--ink);
  }

  .lp-btn--lime:hover {
    background: #c4f66a;
  }

  .lp-btn--outline {
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 2px var(--ink);
  }

  .lp-btn--outline:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .lp-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
