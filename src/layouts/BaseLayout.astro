---
/**
 * Page shell: head, preloader, offcanvas overlay, ScrollSmoother wrapper,
 * header, footer and the script stack.
 *
 * Every <link> and <script> carries `is:inline` so Astro emits them exactly as
 * written instead of bundling them. That matters: theme.js expects jQuery on
 * `window` and GSAP plugins registered globally, which module bundling breaks.
 */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
    <head>
        <!--====== Required meta tags ======-->
        <meta charset="utf-8">
        <meta http-equiv="x-ua-compatible" content="ie=edge">
        <meta name="description" content={description}>
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <!--====== Title ======-->
        <title>{title}</title>
        <!--====== Favicon Icon ======-->
        <link rel="shortcut icon" href="/assets/images/ricksite/logo/ricksite-appicon.svg" type="image/svg+xml">
        <!--====== Google Fonts ======-->
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;700&family=Roboto:ital,wght@0,100..900;1,100..900&family=Source+Sans+3:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">
        <!--====== Flaticon css ======-->
        <link rel="stylesheet" href="/assets/fonts/flaticon/flaticon_agenko.css">
        <!--====== FontAwesome css ======-->
        <link rel="stylesheet" href="/assets/fonts/fontawesome/css/all.min.css">
        <!--====== Bootstrap css ======-->
        <link rel="stylesheet" href="/assets/css/plugins/bootstrap.min.css">
        <!--====== Slick-popup css ======-->
        <link rel="stylesheet" href="/assets/css/plugins/slick.css">
        <!--====== Magnific-popup css ======-->
        <link rel="stylesheet" href="/assets/css/plugins/magnific-popup.css">
        <!--====== Default css ======-->
        <link rel="stylesheet" href="/assets/css/default.css">
        <!--====== Style css ======-->
        <link rel="stylesheet" href="/assets/css/style.css">
        <!--====== Ricksite css (brand accent only) ======-->
        <link rel="stylesheet" href="/assets/css/ricksite.css">
    </head>
    <body>
        <!--====== Preloader ======-->
        <div class="preloader">
            <div class="loading-container">
                <div class="loading"></div>
                <div id="loading-icon"><img src="/assets/images/ricksite/logo/ricksite-mark-light.svg" alt=""></div>
            </div>
        </div>
        <!--====== Start Overlay ======-->
        <div class="offcanvas__overlay"></div>
        <Header />
        <!--======  Smooth Wrapper  ======-->
        <div id="smooth-wrapper">
            <div id="smooth-content">
                <!--======  Main  ======-->
                <main>
                    <slot />
                </main>
                <Footer />
            </div>
        </div>
        <!--====== Jquery js ======-->
        <script is:inline src="/assets/js/plugins/jquery-3.7.1.min.js"></script>
        <!--====== Bootstrap js ======-->
        <script is:inline src="/assets/js/plugins/popper.min.js"></script>
        <!--====== Bootstrap js ======-->
        <script is:inline src="/assets/js/plugins/bootstrap.min.js"></script>
        <!--====== Gsap Js ======-->
        <script is:inline src="/assets/js/plugins/gsap/gsap.min.js"></script>
        <script is:inline src="/assets/js/plugins/gsap/SplitText.min.js"></script>
        <script is:inline src="/assets/js/plugins/gsap/ScrollSmoother.min.js"></script>
        <script is:inline src="/assets/js/plugins/gsap/ScrollTrigger.min.js"></script>
        <!--====== Slick js ======-->
        <script is:inline src="/assets/js/plugins/slick.min.js"></script>
        <!--====== Magnific js ======-->
        <script is:inline src="/assets/js/plugins/jquery.magnific-popup.min.js"></script>
        <!--====== Waypoint js ======-->
        <script is:inline src="/assets/js/plugins/jquery.waypoints.js"></script>
        <!--====== CounterUp js ======-->
        <script is:inline src="/assets/js/plugins/jquery.counterup.min.js"></script>
        <!--====== Main js ======-->
        <script is:inline src="/assets/js/theme.js"></script>
        <!--====== Ricksite js ======-->
        <script is:inline src="/assets/js/ricksite.js"></script>
    </body>
</html>
