---
/**
 * Page shell: head, preloader, offcanvas overlay, ScrollSmoother wrapper,
 * header, footer and the script stack.
 *
 * Every <link> and <script> carries `is:inline` so Astro emits them exactly as
 * written instead of bundling them. That matters: theme.js expects jQuery on
 * `window` and GSAP plugins registered globally, which module bundling breaks.
 */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { whatsapp, WHATSAPP_NUMBER, EMAIL, SOCIAL_LINKS } from '../data/site';
import { asset } from '../lib/asset';

interface Props {
  title: string;
  description: string;
  /** Keep this page out of the index. Only the 404 sets it. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

/**
 * The canonical URL for this page.
 *
 * public/.htaccess already 301s www, http and the .html and trailing-slash
 * spellings onto one form, but a redirect only helps a crawler that follows the
 * wrong URL. This states the right one outright, which is what Search Console
 * reports against.
 *
 * The .html has to come off first. Under `format: 'file'` Astro.url.pathname is
 * the output filename, not the route, so it reads /jasa-seo.html - and naming
 * that as canonical would point Google at a URL the server immediately
 * redirects away from, which is the contradiction Search Console flags rather
 * than resolves.
 */
const canonical = new URL(
  Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, ''),
  Astro.site
).href;

// Absolute, because link previews are fetched by other servers.
const ogImage = new URL('/assets/images/ricksite/pages/ricksite-og.jpg', Astro.site).href;

/**
 * Organization rather than LocalBusiness: LocalBusiness expects a street
 * address, and inventing one to satisfy a schema is exactly the kind of thing
 * that earns a manual action. This states only what is true.
 */
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Ricksite Studio',
  url: 'https://ricksitestudio.com',
  logo: new URL('/assets/images/ricksite/logo/ricksite-appicon.svg', Astro.site).href,
  image: ogImage,
  description:
    'Jasa pembuatan website, web app, dan digital marketing untuk bisnis di Indonesia.',
  email: EMAIL,
  telephone: `+${WHATSAPP_NUMBER}`,
  areaServed: { '@type': 'Country', name: 'Indonesia' },
  sameAs: SOCIAL_LINKS.map((social) => social.href),
};
---

<!DOCTYPE html>
<html lang="id">
    <head>
        <!--====== Required meta tags ======-->
        <meta charset="utf-8">
        <meta http-equiv="x-ua-compatible" content="ie=edge">
        <meta name="description" content={description}>
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <!--====== Title ======-->
        <title>{title}</title>
        <link rel="canonical" href={canonical}>
        {noindex && <meta name="robots" content="noindex, follow">}
        <!--====== Link previews (WhatsApp, Facebook, Instagram, X) ======-->
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Ricksite Studio">
        <meta property="og:locale" content="id_ID">
        <meta property="og:url" content={canonical}>
        <meta property="og:title" content={title}>
        <meta property="og:description" content={description}>
        <meta property="og:image" content={ogImage}>
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content={title}>
        <meta name="twitter:description" content={description}>
        <meta name="twitter:image" content={ogImage}>
        <script type="application/ld+json" is:inline set:html={JSON.stringify(organization)} />
        <!--====== Favicon Icon ======-->
        <link rel="shortcut icon" href={asset("/assets/images/ricksite/logo/ricksite-appicon.svg")} type="image/svg+xml">
        <!--====== Google Fonts ======-->
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;700&family=Roboto:ital,wght@0,100..900;1,100..900&family=Source+Sans+3:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">
        <!--====== Flaticon css ======-->
        <link rel="stylesheet" href={asset("/assets/fonts/flaticon/flaticon_agenko.css")}>
        <!--====== FontAwesome css ======-->
        <link rel="stylesheet" href={asset("/assets/fonts/fontawesome/css/all.min.css")}>
        <!--====== Bootstrap css ======-->
        <link rel="stylesheet" href={asset("/assets/css/plugins/bootstrap.min.css")}>
        <!--====== Slick-popup css ======-->
        <link rel="stylesheet" href={asset("/assets/css/plugins/slick.css")}>
        <!--====== Magnific-popup css ======-->
        <link rel="stylesheet" href={asset("/assets/css/plugins/magnific-popup.css")}>
        <!--====== Default css ======-->
        <link rel="stylesheet" href={asset("/assets/css/default.css")}>
        <!--====== Style css ======-->
        <link rel="stylesheet" href={asset("/assets/css/style.css")}>
        <!--====== Ricksite css (brand accent only) ======-->
        <link rel="stylesheet" href={asset("/assets/css/ricksite.css")}>
        <script is:inline>
            /*
             * Decide before first paint whether the intro plays, so there is no
             * flash of a loader that is about to be skipped.
             *
             * It runs once per browsing session. This is a multi-page static
             * site, so without the gate a 2.3s animation would replay on every
             * internal navigation. Users who ask for reduced motion never see it.
             */
            (function () {
                var skip = false;
                try { skip = sessionStorage.getItem('rs-intro-played') === '1'; } catch (e) {}
                if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) skip = true;
                if (skip) document.documentElement.classList.add('rs-intro-skip');
            })();
        </script>
    </head>
    <body>
        <!--====== Preloader ======-->
        <div class="rs-preloader" id="rs-preloader">
            <div class="rs-intro">
                <div class="rs-intro-mark">
                    <svg viewBox="0 0 100 100" aria-hidden="true">
                        <path
                            d="M18 80 A 32 32 0 0 1 50 48 A 32 32 0 0 0 82 16"
                            pathLength="100"
                            stroke-dasharray="100"
                            fill="none"
                            stroke="#f4f4f1"
                            stroke-width="17"
                            stroke-linecap="round"
                        ></path>
                    </svg>
                    <span class="rs-intro-dot"></span>
                </div>
                <div class="rs-intro-word">
                    <span class="rs-intro-word-thin">RICKSITE</span>
                    <span class="rs-intro-word-bold">STUDIO</span>
                </div>
            </div>
        </div>
        <!--====== Start Overlay ======-->
        <div class="offcanvas__overlay"></div>
        <Header />
        <!--====== WhatsApp Bubble ======-->
        <!-- Deliberately outside #smooth-wrapper: ScrollSmoother animates that
             element with a transform, and a transformed ancestor makes
             position:fixed resolve against it instead of the viewport, so a
             bubble placed inside would scroll away with the page. -->
        <a
            href={whatsapp('Halo Ricksite Studio, saya mau tanya-tanya dulu.')}
            class="rs-wa-bubble"
            target="_blank"
            rel="noopener"
            aria-label="Chat WhatsApp Ricksite Studio"
        >
            <i class="fab fa-whatsapp" aria-hidden="true"></i>
            <span class="rs-wa-bubble-text">Chat WhatsApp</span>
        </a>
        <!--======  Smooth Wrapper  ======-->
        <div id="smooth-wrapper">
            <div id="smooth-content">
                <!--======  Main  ======-->
                <main>
                    <slot />
                </main>
                <Footer />
            </div>
        </div>
        <!--====== Jquery js ======-->
        <script is:inline src={asset("/assets/js/plugins/jquery-3.7.1.min.js")}></script>
        <!--====== Bootstrap js ======-->
        <script is:inline src={asset("/assets/js/plugins/popper.min.js")}></script>
        <!--====== Bootstrap js ======-->
        <script is:inline src={asset("/assets/js/plugins/bootstrap.min.js")}></script>
        <!--====== Gsap Js ======-->
        <script is:inline src={asset("/assets/js/plugins/gsap/gsap.min.js")}></script>
        <script is:inline src={asset("/assets/js/plugins/gsap/SplitText.min.js")}></script>
        <script is:inline src={asset("/assets/js/plugins/gsap/ScrollSmoother.min.js")}></script>
        <script is:inline src={asset("/assets/js/plugins/gsap/ScrollTrigger.min.js")}></script>
        <!--====== Slick js ======-->
        <script is:inline src={asset("/assets/js/plugins/slick.min.js")}></script>
        <!--====== Magnific js ======-->
        <script is:inline src={asset("/assets/js/plugins/jquery.magnific-popup.min.js")}></script>
        <!--====== Waypoint js ======-->
        <script is:inline src={asset("/assets/js/plugins/jquery.waypoints.js")}></script>
        <!--====== CounterUp js ======-->
        <script is:inline src={asset("/assets/js/plugins/jquery.counterup.min.js")}></script>
        <!--====== Main js ======-->
        <script is:inline src={asset("/assets/js/theme.js")}></script>
        <!--====== Ricksite js ======-->
        <script is:inline src={asset("/assets/js/ricksite.js")}></script>
    </body>
</html>
