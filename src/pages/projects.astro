---
/**
 * /projects — the full portfolio, split into tabs by kind of work.
 *
 * The homepage carries a curated six; this shows everything, in a three-column
 * grid rather than the homepage's two, because nine near-square screenshots at
 * half width would make the page very tall.
 *
 * Two things about the tabs are deliberate. Every project is rendered once per
 * tab it belongs to, so the markup repeats — but the panes stay declarative and
 * the browser still fetches each screenshot once, which is the better trade at
 * nine projects. And the cards carry no `pf_fadeup`: that animation sets its
 * target to autoAlpha 0 straight away and only reveals it when a ScrollTrigger
 * fires, which cannot happen inside a hidden pane, so an animated card would
 * still be invisible after its tab was opened. The section title keeps it.
 *
 * Where a card points is ProjectCard's decision, not this page's.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { projectCategories, projectsIn } from '../data/projects';
import ProjectCard from '../components/ProjectCard.astro';

const title = 'Portofolio Project - Ricksite Studio';
const description =
  'Website, toko online, dan sistem internal yang sudah kami bangun untuk bisnis nyata di berbagai industri.';
---

<BaseLayout title={title} description={description}>
    <!--====== Start Page Banner ======-->
    <section class="agenko-page-banner">
        <div class="shape shape-circle1"><span></span></div>
        <div class="shape shape-circle2"><span></span></div>
        <div class="container">
            <div class="row">
                <div class="col-lg-9">
                    <!--=== Page Content ===-->
                    <div class="page-content">
                        <h1 class="page-title">Portofolio</h1>
                        <div class="row">
                            <div class="col-xl-9">
                                <div class="text-box">
                                    <p>Website, toko online, dan sistem internal yang sudah jalan di bisnis nyata — dari travel dan tailor sampai ERP dan sistem tagihan.</p>
                                </div>
                            </div>
                        </div>
                        <ul class="breadcrumb-link mt-30">
                            <li><a href="/">Beranda</a></li>
                            <li class="active">Portofolio</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section><!--====== End Page Banner ======-->

    <!--======  Start Project Section  ======-->
    <section class="agk-project pt-130 pb-80">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <!--=== Section Title ===-->
                    <div class="section-title mb-60 pf_fadeup">
                        <span class="sub-title">Semua Project</span>
                        <h2>Bukan Demo Template.
                            Ini Project Client Kami.</h2>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="text-box mb-60 pf_fadeup">
                        <p>Sebagian sistem internal tidak bisa kami tampilkan lebih jauh dari ini, karena datanya milik client.</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12">
                    <ul class="nav nav-tabs rs-tabs pf_fadeup" role="tablist">
                        {projectCategories.map((category, index) => (
                            <Fragment>
                            <li class="nav-item" role="presentation">
                                <button
                                    class={`nav-link${index === 0 ? ' active' : ''}`}
                                    data-bs-toggle="tab"
                                    data-bs-target={`#tab-${category.id}`}
                                    type="button"
                                    role="tab"
                                    aria-selected={index === 0 ? 'true' : 'false'}
                                >{category.title}</button>
                            </li>
                            {" "}</Fragment>
                        ))}
                    </ul>
                    <div class="tab-content rs-tab-content">
                        {projectCategories.map((category, index) => (
                            <Fragment>
                            <div class={`tab-pane fade${index === 0 ? ' show active' : ''}`} id={`tab-${category.id}`} role="tabpanel">
                                <div class="row">
                                    {projectsIn(category.id).map((project) => (
                                        <Fragment>
                                        <ProjectCard project={project} columns="col-lg-4 col-md-6" animate={false} />
                                        {" "}</Fragment>
                                    ))}
                                </div>
                            </div>
                            {" "}</Fragment>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </section><!--======  End Project Section  ======-->

    <FinalCta />
</BaseLayout>
