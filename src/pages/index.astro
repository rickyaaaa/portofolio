---
/**
 * Ricksite Studio homepage.
 *
 * Section order matches the original index.html:
 * Hero -> Projects -> Services -> Why -> Process
 * -> Inquiry form -> About -> Final CTA. Pricing lives on the service pages.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import FeaturedProjects from '../components/sections/FeaturedProjects.astro';
import Services from '../components/sections/Services.astro';
import WhyRicksite from '../components/sections/WhyRicksite.astro';
import WorkProcess from '../components/sections/WorkProcess.astro';
import InquiryForm from '../components/sections/InquiryForm.astro';
import About from '../components/sections/About.astro';
import FinalCta from '../components/sections/FinalCta.astro';

const title = 'Jasa Pembuatan Website & Digital Marketing | Ricksite Studio';
const description =
  'Ricksite Studio: jasa pembuatan website, aplikasi web, SEO, Google Ads, dan Meta Ads dari Tangerang Selatan untuk bisnis di seluruh Indonesia.';
---

<BaseLayout title={title} description={description}>
    <Hero />
    <FeaturedProjects />
    <Services />
    <WhyRicksite />
    <WorkProcess />
    <InquiryForm />
    <About />
    <FinalCta />
</BaseLayout>
