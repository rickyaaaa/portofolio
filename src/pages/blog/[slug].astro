---
/**
 * One blog article at /blog/<slug>. Markdown body from src/content/artikel/<slug>.md, wrapped
 * in the same page banner as the service pages so the blog reads as part of
 * the site rather than a bolted-on template.
 *
 * Articles exist to answer what buyers ask before they hire a studio, and to
 * hand them on to the service page that sells the answer - the links live in
 * the Markdown itself, next to the sentence they belong to.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import { articles, formatDate, BLOG_PATH, type Article } from '../../lib/articles';

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props as { article: Article };
const { Content } = article;

const url = new URL(Astro.url.pathname, Astro.site).href;

// The founder is the named author (the strongest experience signal an article
// can carry); the studio is the publisher the copy speaks for as "kami".
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title,
  description: article.description,
  datePublished: article.date,
  dateModified: article.updated ?? article.date,
  inLanguage: 'id-ID',
  mainEntityOfPage: url,
  author: {
    '@type': 'Person',
    name: article.author.name,
    jobTitle: article.author.role,
    url: 'https://ricksitestudio.com/tentang',
    worksFor: { '@type': 'Organization', name: 'Ricksite Studio', url: 'https://ricksitestudio.com' },
  },
  publisher: { '@type': 'Organization', name: 'Ricksite Studio', url: 'https://ricksitestudio.com' },
  ...(article.ogImage && { image: new URL(article.ogImage, Astro.site).href }),
};
---

<BaseLayout title={article.seoTitle} description={article.description} image={article.ogImage} ogType="article">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

    <!--====== Start Page Banner ======-->
    <section class="agenko-page-banner">
        <div class="shape shape-circle1"><span></span></div>
        <div class="shape shape-circle2"><span></span></div>
        <div class="container">
            <div class="row">
                <div class="col-lg-10">
                    <div class="page-content">
                        <h1 class="page-title rs-article-title">{article.title}</h1>
                        <div class="row">
                            <div class="col-xl-9">
                                <div class="text-box">
                                    <p>
                                        Oleh <strong>{article.author.name}</strong> &middot; <time datetime={article.date}>{formatDate(article.date)}</time>
                                        {article.updated && <Fragment> &middot; diperbarui <time datetime={article.updated}>{formatDate(article.updated)}</time></Fragment>}
                                    </p>
                                </div>
                            </div>
                        </div>
                        <ul class="breadcrumb-link mt-30">
                            <li><a href="/">Beranda</a></li>
                            <li><a href={BLOG_PATH}>Blog</a></li>
                            <li class="active">Artikel</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section><!--====== End Page Banner ======-->

    <section class="rs-article-section pt-100 pb-100">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <article class="rs-article">
                        {article.cover && (
                            <Image
                                src={article.cover}
                                alt={article.coverAlt ?? article.title}
                                widths={[400, 800, 1200]}
                                sizes="(max-width: 991px) 100vw, 760px"
                                class="rs-article-cover"
                                loading="eager"
                                fetchpriority="high"
                            />
                        )}
                        <Content />
                    </article>

                    <aside class="rs-author-box" aria-label="Penulis">
                        <p class="rs-author-label rs-h5">Penulis</p>
                        <div class="rs-author">
                            <div class="rs-author-avatar" aria-hidden="true">{article.author.initials}</div>
                            <div class="rs-author-info">
                                <p class="rs-author-name">{article.author.name}</p>
                                <p class="rs-author-role">{article.author.role}</p>
                                <p class="rs-author-bio">{article.author.bio}</p>
                            </div>
                        </div>
                    </aside>
                </div>
            </div>
        </div>
    </section>

    <FinalCta heading="Mau Tahu Biaya Pasti untuk Bisnismu?" />
</BaseLayout>
