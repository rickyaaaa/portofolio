---
/**
 * Service landing pages — one template, five pages, generated from the service
 * catalogue at build time.
 *
 * Each page targets one keyword cluster ("jasa pembuatan website", "jasa seo",
 * ...) instead of the homepage trying to rank for all of them. Structure:
 * banner -> problems -> deliverables -> pricing for this service only ->
 * related work (when there is any) -> FAQ -> pre-filled inquiry form.
 *
 * Built from stock Agenko parts: agenko-page-banner, agenko-iconic-box
 * style-four, check-list style-one, agk-accordion, agenko-project-item.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Pricing from '../components/sections/Pricing.astro';
import InquiryForm from '../components/sections/InquiryForm.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { services, websiteSubServices, servicePath } from '../data/services';
import { servicePages } from '../data/service-pages';
import { projects } from '../data/projects';
import ProjectCard from '../components/ProjectCard.astro';
import { whatsapp } from '../data/site';
import { Image } from 'astro:assets';
// Same captures the /konsultasi landing uses for these two results.
import abunawasImage from '../assets/landing/gambar-2-abunawas-travel.webp';
import travelChatImage from '../assets/landing/gambar-1-testimoni-google-ads.webp';

const caseImages = { abunawas: abunawasImage, 'travel-chat': travelChatImage };

export function getStaticPaths() {
  return [...services, ...websiteSubServices].map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const page = servicePages[service.slug];

// Sub-pages sit under their main service in the breadcrumb.
const parentService = service.parent ? services.find((s) => s.slug === service.parent) : undefined;

// The website page and its sub-pages take a free-text "Jenis Website" field;
// the other build services pick from the service list.
const websiteForm = service.slug === 'jasa-pembuatan-website' || service.parent === 'jasa-pembuatan-website';

const related = projects.filter((project) => page.relatedProjects.includes(project.slug));

const title = page.seoTitle;
const description = page.metaDescription;

const consultLink = whatsapp(
  `Halo Ricksite Studio, saya mau tanya soal ${service.title}.`
);
---

<BaseLayout title={title} description={description}>
    <!--====== Start Page Banner ======-->
    <section class="agenko-page-banner">
        <div class="shape shape-circle1"><span></span></div>
        <div class="shape shape-circle2"><span></span></div>
        <div class="container">
            <div class="row">
                <div class="col-lg-9">
                    <!--=== Page Content ===-->
                    <div class="page-content">
                        <h1 class="page-title">{page.h1}</h1>
                        <div class="row">
                            <div class="col-xl-9">
                                <div class="text-box">
                                    <p>{page.tagline}</p>
                                </div>
                            </div>
                        </div>
                        <ul class="breadcrumb-link mt-30">
                            <li><a href="/">Beranda</a></li>
                            {parentService && <li><a href={servicePath(parentService)}>{parentService.title}</a></li>}
                            <li class="active">{service.shortTitle ?? service.title}</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section><!--====== End Page Banner ======-->

    <!--====== Start Problems Section ======-->
    <section class="agk-service-problem pt-130 pb-100">
        <div class="container">
            <div class="row">
                <div class="col-xl-5">
                    <!--=== Section Title ===-->
                    <div class="section-title mb-40 pf_fadeup">
                        <span class="sub-title">Kenapa Perlu</span>
                        <h2>{page.problemsHeading}</h2>
                    </div>
                    <div class="agk-button pf_fadeup">
                        <a href={consultLink} target="_blank" rel="noopener" class="theme-btn style-one">
                            <span class="text-flip">
                                <span class="text">KONSULTASI GRATIS</span>
                                <span class="text">KONSULTASI GRATIS</span>
                            </span>
                        </a>
                    </div>
                </div>
                <div class="col-xl-7">
                    <div class="rs-problem-list pf_fadeup">
                        {page.problems.map((problem, index) => (
                            <Fragment>
                            <div class="rs-problem-item">
                                <span class="rs-problem-no">{String(index + 1).padStart(2, '0')}</span>
                                <p>{problem}</p>
                            </div>
                            {" "}</Fragment>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </section><!--====== End Problems Section ======-->

    <!--====== Start Deliverables Section ======-->
    <section class="agk-service-deliverables gray-dark pt-130 pb-100">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <!--=== Section Title ===-->
                    <div class="section-title mb-50 pf_fadeup">
                        <span class="sub-title">Yang Kami Kerjakan</span>
                        <h2>Cakupan {page.keyword}.</h2>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="text-box mb-50 pf_fadeup">
                        <p>{page.intro}</p>
                    </div>
                </div>
            </div>
            <div class="row">
                {service.solutions.map((solution) => (
                    <Fragment>
                    <div class="col-xl-4 col-md-6 col-sm-12">
                        <div class="agenko-iconic-box style-four rs-deliverable mb-30 pf_fadeup">
                            <div class="icon">
                                <i class={service.icon}></i>
                            </div>
                            <div class="content">
                                <h3 class="title rs-h4">
                                    {service.solutionLinks?.[solution]
                                        ? <a href={service.solutionLinks[solution]} class="rs-deliverable-link">{solution} <i class="far fa-arrow-right"></i></a>
                                        : solution}
                                </h3>
                            </div>
                        </div>
                    </div>
                    {" "}</Fragment>
                ))}
            </div>
        </div>
    </section><!--====== End Deliverables Section ======-->

    {/* Same Agenko step cards as the homepage process, with steps per service. */}
    {page.process && (
        <section class="agk-work-process pt-130 pb-100">
            <div class="container">
                <div class="row">
                    <div class="col-lg-8">
                        <!--=== Section Title ===-->
                        <div class="section-title mb-50 pf_fadeup">
                            <span class="sub-title">Cara Kerja</span>
                            <h2>{page.processHeading}</h2>
                        </div>
                    </div>
                </div>
                <div class="row">
                    {page.process.map((step) => (
                        <Fragment>
                        <div class="col-xl-3 col-md-6 col-sm-12">
                            <div class="agenko-iconic-box style-two mb-40 pf_fadeup">
                                <div class="icon">
                                    <i class={step.icon}></i>
                                </div>
                                <div class="content">
                                    <h3 class="title rs-h4">{step.title}</h3>
                                    <p>{step.description}</p>
                                    <div class="step">{step.step}</div>
                                </div>
                            </div>
                        </div>
                        {" "}</Fragment>
                    ))}
                </div>
            </div>
        </section>
    )}

    <Pricing
        categoryIds={service.pricingCategories}
        eyebrow="Harga"
        heading={`Harga ${page.keyword}.`}
        intro="Harga di depan, tanpa biaya kaget. Kalau kebutuhanmu di luar paket, tinggal cerita — nanti kami buatkan penawaran khusus."
    />

    {/* A real result for this service, when there is one. Dark, so it sits
        between the gray pricing and FAQ sections instead of merging into them. */}
    {page.caseStudy && (
        <section class="agk-case-study pt-130 pb-100">
            <div class="container">
                <div class="row">
                    <div class="col-lg-8">
                        <!--=== Section Title ===-->
                        <div class="section-title mb-50 pf_fadeup">
                            <span class="sub-title">Hasil Client</span>
                            <h2>{page.caseStudy.heading}</h2>
                        </div>
                    </div>
                </div>
                <div class="row align-items-center rs-case pf_fadeup">
                    <div class="col-lg-5 mb-40">
                        <div class="rs-case-media">
                            <Image
                                src={caseImages[page.caseStudy.image]}
                                alt={page.caseStudy.imageAlt}
                                widths={[420, 840]}
                                sizes="(min-width: 992px) 440px, 100vw"
                                loading="lazy"
                                decoding="async"
                            />
                        </div>
                    </div>
                    <div class="col-lg-7 mb-40">
                        <div class="rs-case-body">
                            <span class="rs-case-tag">{page.caseStudy.tag}</span>
                            <h3 class="rs-h4 rs-case-title">
                                {page.caseStudy.title}
                                {page.caseStudy.url && (
                                    <a href={page.caseStudy.url} target="_blank" rel="noopener" class="rs-case-link">{new URL(page.caseStudy.url).hostname}</a>
                                )}
                            </h3>
                            <dl class="rs-case-stats">
                                {page.caseStudy.stats.map((stat) => (
                                    <div>
                                        <dd class="rs-h2">{stat.value}</dd>
                                        <dt>{stat.label}</dt>
                                    </div>
                                ))}
                            </dl>
                            <p>{page.caseStudy.text}</p>
                            {page.caseStudy.note && <p class="rs-case-note">{page.caseStudy.note}</p>}
                        </div>
                    </div>
                </div>
            </div>
        </section>
    )}

    {/* Related work (portfolio cards) is skipped for SEO and ads; their proof is the case study above. */}
    {related.length > 0 && (
        <section class="agk-project pt-130 pb-80">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-7">
                        <!--=== Section Title ===-->
                        <div class="section-title mb-60 pf_fadeup">
                            <span class="sub-title">Portofolio</span>
                            <h2>Yang Sudah Kami Kerjakan.</h2>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="agk-button mb-60 float-lg-end pf_fadeup">
                            <a href="/projects" class="theme-btn style-one">
                                <span class="text-flip">
                                    <span class="text">Lihat Semua Project</span>
                                    <span class="text">Lihat Semua Project</span>
                                </span>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="row">
                    {related.map((project) => (
                        <Fragment>
                        <ProjectCard project={project} columns="col-lg-4 col-md-6" />
                        {" "}</Fragment>
                    ))}
                </div>
            </div>
        </section>
    )}

    <!--====== Start FAQ Section ======-->
    <section class="agk-faq gray-dark pt-130 pb-100">
        <div class="container">
            <div class="row">
                <div class="col-lg-7">
                    <!--=== Section Title ===-->
                    <div class="section-title mb-50 pf_fadeup">
                        <span class="sub-title">FAQ</span>
                        <h2>{page.faqHeading}</h2>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12">
                    <!--====== Accordion ======-->
                    <div class="agk-accordion" id="faqAccordion">
                        {page.faqs.map((faq, index) => (
                            <Fragment>
                            <!--====== Accordion Item ======-->
                            <div class="agenko-accordion-item mb-20 pf_fadeup">
                                <div class="accordion-header">
                                    <h3
                                        class="accordion-title rs-h6"
                                        data-bs-toggle="collapse"
                                        data-bs-target={`#faq-${index}`}
                                        aria-expanded={index === 0 ? 'true' : 'false'}
                                    >
                                        {faq.q}
                                    </h3>
                                </div>
                                <div
                                    id={`faq-${index}`}
                                    class={`accordion-collapse collapse${index === 0 ? ' show' : ''}`}
                                    data-bs-parent="#faqAccordion"
                                >
                                    <div class="accordion-content">
                                        <p>{faq.a}</p>
                                    </div>
                                </div>
                            </div>
                            {" "}</Fragment>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </section><!--====== End FAQ Section ======-->

    {/* Form only on the build services. Marketing pages close on the CTA banner. */}
    {service.category === 'development' && (
        <InquiryForm
            preselect={websiteForm ? undefined : service.title}
            serviceField={websiteForm ? 'text' : 'select'}
            serviceLabel={websiteForm ? 'Jenis Website' : 'Layanan yang Diinginkan'}
            servicePlaceholder="Contoh: toko online sepatu, company profile klinik, website travel"
            eyebrow="Mulai Project"
            heading={`Tertarik ${page.keyword}?`}
            intro="Isi kolom di bawah, nanti kami balas dengan rekomendasi dan estimasi yang paling pas buat bisnismu."
        />
    )}

    <FinalCta heading={page.ctaHeading} />
</BaseLayout>
