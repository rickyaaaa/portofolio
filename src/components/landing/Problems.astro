---
/**
 * The four problems, phrased the way an owner would say them. Each card's
 * second line names what the problem costs, which is the part that moves
 * someone from "relatable" to "I should fix this".
 *
 * Icons are inline SVG paths (24px grid, 2px stroke) so the page needs no
 * icon font.
 */
const problems = [
  {
    title: 'Calon tamu hilang setelah tanya harga',
    body: 'Sudah balas panjang lebar, dikirim pricelist, lalu dibaca saja. Atau sudah deal, tapi batal karena tidak ada DP yang mengikat.',
    icon: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm8-3 5 5m0-5-5 5',
  },
  {
    title: 'Chat WA penuh pertanyaan yang sama',
    body: '"Harganya berapa?", "Itinerary-nya gimana?", "Jadwal bulan depan ada?" Diulang puluhan kali sehari, waktu habis untuk balas chat.',
    icon: 'M21 11.5a8.4 8.4 0 0 1-9 8.4 8.6 8.6 0 0 1-3.8-.9L3 21l1.9-5.2A8.4 8.4 0 1 1 21 11.5ZM8 10h8M8 14h5',
  },
  {
    title: 'Tidak muncul di Google',
    body: 'Orang cari "paket tour" di kota kamu, yang muncul kompetitor dan OTA. Bisnis kamu tidak kelihatan sama sekali.',
    icon: 'M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm10 2-4.35-4.35M8.5 8.5l5 5m0-5-5 5',
  },
  {
    title: 'Bergantung ke OTA & mulut ke mulut',
    body: 'Komisi OTA memotong margin, dan kalau rekomendasi sepi, booking ikut sepi. Tidak ada saluran yang kamu kendalikan sendiri.',
    icon: 'M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7.1-7.1l-1.7 1.7M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7.1 7.1l1.7-1.7',
  },
];
---

<section class="lp-section" aria-labelledby="problems-title">
  <div class="lp-wrap">
    <div class="lp-head">
      <span class="lp-eyebrow">Masalah yang sering terjadi</span>
      <h2 class="lp-h2" id="problems-title">Kenal dengan salah satu dari ini?</h2>
    </div>

    <ul class="problems" role="list">
      {problems.map((p) => (
        <li class="problem">
          <span class="problem-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d={p.icon} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <h3 class="problem-title">{p.title}</h3>
          <p class="problem-body">{p.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .problems {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .problem {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
  }

  .problem-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--danger-bg);
    color: var(--danger);
    margin-bottom: 18px;
  }

  .problem-title {
    font-size: 18px;
    line-height: 1.35;
    font-weight: 700;
    color: var(--ink);
  }

  .problem-body {
    margin-top: 8px;
    font-size: 15px;
    color: var(--muted);
  }

  @media (min-width: 640px) {
    .problems {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (min-width: 1024px) {
    .problems {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
