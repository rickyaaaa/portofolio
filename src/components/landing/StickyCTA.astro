---
/**
 * Mobile-only bottom bar that scrolls to the form.
 *
 * Hidden while the form is on screen (nothing to point at) and while the hero
 * button is still visible (two identical buttons on one screen). It moves
 * with transform only and the body reserves its height up front
 * (LandingLayout), so showing and hiding it never shifts the layout.
 */
---

<div class="sticky-cta" id="sticky-cta" data-visible="false" inert>
  <a href="#form" class="lp-btn sticky-btn" data-cta="sticky" tabindex="-1">Cek Kebutuhan Website</a>
</div>

<script>
  const bar = document.getElementById('sticky-cta');
  const link = bar?.querySelector<HTMLAnchorElement>('a');
  const formSection = document.getElementById('form');
  const heroBtn = document.querySelector('[data-cta="hero"]');

  if (bar && link && formSection && 'IntersectionObserver' in window) {
    const inView = new Map<Element, boolean>([
      [formSection, false],
      [heroBtn ?? formSection, heroBtn ? true : false],
    ]);

    const update = () => {
      const show = !Array.from(inView.values()).some(Boolean);
      bar.dataset.visible = String(show);
      // Out of the tab order while it is off screen.
      link.tabIndex = show ? 0 : -1;
      bar.toggleAttribute('inert', !show);
    };

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) inView.set(entry.target, entry.isIntersecting);
      update();
    });

    observer.observe(formSection);
    if (heroBtn) observer.observe(heroBtn);
  } else if (bar && link) {
    // No IntersectionObserver: just show the bar.
    bar.dataset.visible = 'true';
    bar.removeAttribute('inert');
    link.tabIndex = 0;
  }
</script>

<style>
  .sticky-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, 0.96);
    border-top: 1px solid var(--line);
    box-shadow: 0 -8px 24px rgba(13, 13, 13, 0.08);
    transform: translateY(110%);
    transition: transform 0.25s ease;
  }

  .sticky-cta[data-visible='true'] {
    transform: translateY(0);
  }

  .sticky-btn {
    width: 100%;
  }

  @media (min-width: 768px) {
    .sticky-cta {
      display: none;
    }
  }
</style>
