---
/**
 * Proof, placed straight after the problems so a visitor sees it before the
 * long feature list rather than ~4000px down the page on a phone.
 *
 * Each card is screenshot on top, results below. Every screenshot sits in
 * the same fixed-ratio frame, so across the desktop row the pictures line up
 * and the text starts at the same height in every card, however long it is.
 * (With the picture at the bottom, cards with less text left a gap above it.)
 *
 * Images go through astro:assets, so the build emits resized WebP with width
 * and height attributes (no layout shift) and they load lazily below the fold.
 *
 * The cards carry no outbound links on purpose: a click from an ad landing
 * page to someone else's site is a lead that leaves.
 *
 * The Abunawas card leads because its numbers are named and checkable.
 */
import { Image } from 'astro:assets';
// [gambar_1] The client's own WhatsApp reply about the Google Ads results,
// cropped from the chat (bubbles re-stacked to a phone width, wording and
// order untouched; the opening question is left out because the reply
// quotes it in full). The card's numbers follow this chat.
// TODO: confirm the client agreed to having this chat shown in ads.
import gambar1 from '../../assets/landing/gambar-1-testimoni-google-ads.webp';
// TODO: gambar - [gambar_2] Abunawas Travel. Swap for a newer capture if needed.
import gambar2 from '../../assets/landing/gambar-2-abunawas-travel.webp';
// TODO: gambar - [gambar_3] other portfolio: Bernard Bali Tours + Bali Rejeng Jeep Tour.
import gambar3a from '../../assets/landing/gambar-3-bernard-bali-tours.webp';
import gambar3b from '../../assets/landing/gambar-4-bali-rejeng-jeep-tour.webp';

const sizes = '(min-width: 1024px) 352px, (min-width: 640px) 50vw, 100vw';
const pairSizes = '(min-width: 1024px) 176px, (min-width: 640px) 25vw, 50vw';
---

<section class="lp-section lp-section--sand" aria-labelledby="cases-title">
  <div class="lp-wrap">
    <div class="lp-head">
      <span class="lp-eyebrow">Hasil client</span>
      <h2 class="lp-h2" id="cases-title">Sudah dipakai travel lain, dengan hasil yang terukur</h2>
    </div>

    <div class="cases">
      <article class="case case--featured">
        <div class="case-media">
          <Image src={gambar2} alt="Tampilan website Abunawas Travel" widths={[360, 620]} sizes={sizes} class="case-img" loading="lazy" decoding="async" />
        </div>
        <div class="case-body">
          <p class="case-tag">Sistem booking + SEO</p>
          <h3 class="case-title">Abunawas Travel <span class="case-domain">abunawastravel.id</span></h3>
          <dl class="stats stats--3">
            <div>
              <dt>Posisi rata-rata</dt>
              <dd>9</dd>
            </div>
            <div>
              <dt>CTR</dt>
              <dd>12,7%</dd>
            </div>
            <div>
              <dt>Klik / 3 bulan</dt>
              <dd>531</dd>
            </div>
          </dl>
          <p class="case-text">Paket tour luar negeri dengan sistem booking online. Posisi rata-rata di Google, data dari Google Search Console.</p>
        </div>
      </article>

      <article class="case">
        <div class="case-media case-media--chat">
          <Image
            src={gambar1}
            alt="Chat WhatsApp dari client: ditanya apakah ada perkembangan dibanding iklan sebelum redesign, client menjawab perkembangannya makin besar. Ditanya sudah ada yang closing, client menjawab sudah, 5 WA closing."
            widths={[480, 955]}
            sizes={sizes}
            class="case-img"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="case-body">
          <p class="case-tag">Website + Google Ads</p>
          <h3 class="case-title">Client Travel</h3>
          <dl class="stats stats--1">
            <div>
              <dt>Closing lewat WhatsApp</dt>
              <dd>5</dd>
            </div>
          </dl>
          <p class="case-text">Website di-redesign lalu dipasangkan Google Ads. Dibanding iklan sebelum redesign, perkembangannya makin besar, kata client langsung.</p>
          <p class="case-note">Screenshot di atas: chat asli dari client.</p>
        </div>
      </article>

      <article class="case">
        <div class="case-media case-media--pair">
          <Image src={gambar3a} alt="Tampilan website Bernard Bali Tours" widths={[300, 620]} sizes={pairSizes} class="case-img" loading="lazy" decoding="async" />
          <Image src={gambar3b} alt="Tampilan website Bali Rejeng Jeep Tour" widths={[300, 620]} sizes={pairSizes} class="case-img" loading="lazy" decoding="async" />
        </div>
        <div class="case-body">
          <p class="case-tag">Portofolio lain</p>
          <h3 class="case-title">Tour operator Bali</h3>
          <ul class="case-list" role="list">
            <li>Bernard Bali Tours</li>
            <li>Bali Rejeng Jeep Tour</li>
          </ul>
          <p class="case-text">Website paket tour dan aktivitas dengan tombol booking di setiap paket.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .cases {
    display: grid;
    gap: 20px;
  }

  .case {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper);
  }

  .case--featured {
    border: 2px solid var(--ink);
  }

  /* One frame for every screenshot: same height in every card, with the top
     of the site shown (its hero and menu). */
  .case-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--sand);
    border-bottom: 1px solid var(--line);
  }

  .case-media--pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .case-media :global(.case-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  /* A chat is read, not glanced at: show all of it, on the chat's own dark
     background, instead of cropping it to fill the frame. */
  .case-media--chat {
    background: #161817;
    display: grid;
    place-items: center;
    padding: 0 4px;
  }

  .case-media--chat :global(.case-img) {
    height: auto;
    max-height: 100%;
    object-fit: contain;
  }

  .case-media--pair :global(.case-img + .case-img) {
    border-left: 1px solid var(--line);
  }

  .case-body {
    padding: 22px 24px 24px;
  }

  .case-tag {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--sand);
    border-radius: 999px;
    padding: 4px 12px;
  }

  .case--featured .case-tag {
    background: var(--lime);
  }

  .case-title {
    margin-top: 14px;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 700;
    color: var(--ink);
  }

  .case-domain {
    display: block;
    font-size: 14px;
    font-weight: 400;
    color: var(--muted);
  }

  .stats {
    margin: 20px 0 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .stats--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .stats--1 {
    grid-template-columns: 1fr;
  }

  .stats div {
    min-width: 0;
    background: var(--sand);
    border-radius: var(--radius-sm);
    padding: 12px 10px;
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }

  .stats dt {
    font-size: 12px;
    line-height: 1.35;
    color: var(--muted);
    margin-top: 4px;
  }

  .stats dd {
    margin: 0;
    font-size: clamp(22px, 6.4vw, 28px);
    line-height: 1.1;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .case-list {
    margin-top: 16px;
    padding-left: 20px;
    font-weight: 600;
    color: var(--ink);
  }

  .case-text {
    margin-top: 16px;
    font-size: 15px;
    color: var(--muted);
  }

  .case-note {
    margin-top: 10px;
    font-size: 13px;
    color: var(--muted);
  }

  @media (min-width: 640px) {
    .cases {
      grid-template-columns: repeat(2, 1fr);
    }

    /* Full-width card on tablets: picture beside the text, not a tall
       full-width screenshot above it. */
    .case--featured {
      grid-column: 1 / -1;
      flex-direction: row;
    }

    .case--featured .case-media {
      flex: 0 0 46%;
      aspect-ratio: auto;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }

    .case--featured .case-body {
      align-self: center;
    }
  }

  @media (min-width: 1024px) {
    .cases {
      grid-template-columns: repeat(3, 1fr);
    }

    .case--featured {
      grid-column: auto;
      flex-direction: column;
    }

    .case--featured .case-media {
      flex: none;
      aspect-ratio: 16 / 10;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .case--featured .case-body {
      align-self: auto;
    }
  }
</style>
