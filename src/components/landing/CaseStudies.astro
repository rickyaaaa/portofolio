---
/**
 * Proof. Results first, screenshot second: an owner skimming on a phone
 * should see the numbers before scrolling past the picture.
 *
 * Images go through astro:assets, so the build emits resized WebP with width
 * and height attributes (no layout shift) and they load lazily below the fold.
 *
 * The cards carry no outbound links on purpose: a click from an ad landing
 * page to someone else's site is a lead that leaves.
 *
 * The Abunawas card leads because its numbers are named and checkable.
 */
import { Image } from 'astro:assets';
// TODO: gambar - [gambar_1] is a generated placeholder. Replace this file with
// a screenshot of the client travel site (620x560 or larger, same aspect).
import gambar1 from '../../assets/landing/gambar-1-client-travel.webp';
// TODO: gambar - [gambar_2] Abunawas Travel. Swap for a newer capture if needed.
import gambar2 from '../../assets/landing/gambar-2-abunawas-travel.webp';
// TODO: gambar - [gambar_3] other portfolio: Bernard Bali Tours + Bali Rejeng Jeep Tour.
import gambar3a from '../../assets/landing/gambar-3-bernard-bali-tours.webp';
import gambar3b from '../../assets/landing/gambar-4-bali-rejeng-jeep-tour.webp';

const sizes = '(min-width: 1024px) 352px, (min-width: 640px) 50vw, 100vw';
---

<section class="lp-section" aria-labelledby="cases-title">
  <div class="lp-wrap">
    <div class="lp-head">
      <span class="lp-eyebrow">Hasil client</span>
      <h2 class="lp-h2" id="cases-title">Sudah dipakai travel lain, dengan hasil yang terukur</h2>
    </div>

    <div class="cases">
      <article class="case case--featured">
        <div class="case-body">
          <p class="case-tag">Sistem booking + SEO</p>
          <h3 class="case-title">Abunawas Travel <span class="case-domain">abunawastravel.id</span></h3>
          <dl class="stats stats--3">
            <div>
              <dt>Posisi rata-rata</dt>
              <dd>9</dd>
            </div>
            <div>
              <dt>CTR</dt>
              <dd>12,7%</dd>
            </div>
            <div>
              <dt>Klik / 3 bulan</dt>
              <dd>531</dd>
            </div>
          </dl>
          <p class="case-text">Paket tour luar negeri dengan sistem booking online. Posisi rata-rata di Google, data dari Google Search Console.</p>
        </div>
        <Image src={gambar2} alt="Tampilan website Abunawas Travel" widths={[360, 620]} sizes={sizes} class="case-img" loading="lazy" decoding="async" />
      </article>

      <article class="case">
        <div class="case-body">
          <p class="case-tag">Website + Google Ads</p>
          <h3 class="case-title">Client Travel</h3>
          <dl class="stats">
            <div>
              <dt>Calon tamu masuk</dt>
              <dd>7</dd>
            </div>
            <div>
              <dt>Berhasil closing</dt>
              <dd>3</dd>
            </div>
          </dl>
          <p class="case-text">Website baru dipasangkan iklan Google Ads. Dari 7 calon tamu yang masuk, 3 deal dan booking.</p>
        </div>
        <Image src={gambar1} alt="Tampilan website client travel" widths={[360, 620]} sizes={sizes} class="case-img" loading="lazy" decoding="async" />
      </article>

      <article class="case">
        <div class="case-body">
          <p class="case-tag">Portofolio lain</p>
          <h3 class="case-title">Tour operator Bali</h3>
          <ul class="case-list" role="list">
            <li>Bernard Bali Tours</li>
            <li>Bali Rejeng Jeep Tour</li>
          </ul>
          <p class="case-text">Website paket tour dan aktivitas dengan tombol booking di setiap paket.</p>
        </div>
        <div class="case-pair">
          <Image src={gambar3a} alt="Tampilan website Bernard Bali Tours" widths={[300, 620]} sizes="(min-width: 1024px) 176px, 50vw" class="case-img" loading="lazy" decoding="async" />
          <Image src={gambar3b} alt="Tampilan website Bali Rejeng Jeep Tour" widths={[300, 620]} sizes="(min-width: 1024px) 176px, 50vw" class="case-img" loading="lazy" decoding="async" />
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .cases {
    display: grid;
    gap: 20px;
  }

  .case {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper);
  }

  .case--featured {
    border: 2px solid var(--ink);
  }

  .case-body {
    padding: 24px;
    flex: 1;
  }

  .case-tag {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--sand);
    border-radius: 999px;
    padding: 4px 12px;
  }

  .case--featured .case-tag {
    background: var(--lime);
  }

  .case-title {
    margin-top: 14px;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 700;
    color: var(--ink);
  }

  .case-domain {
    display: block;
    font-size: 14px;
    font-weight: 400;
    color: var(--muted);
  }

  .stats {
    margin: 20px 0 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .stats--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .stats div {
    min-width: 0;
    background: var(--sand);
    border-radius: var(--radius-sm);
    padding: 12px 10px;
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }

  .stats dt {
    font-size: 12px;
    line-height: 1.35;
    color: var(--muted);
    margin-top: 4px;
  }

  .stats dd {
    margin: 0;
    font-size: clamp(22px, 6.4vw, 28px);
    line-height: 1.1;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .case-list {
    margin-top: 16px;
    padding-left: 20px;
    font-weight: 600;
    color: var(--ink);
  }

  .case-text {
    margin-top: 16px;
    font-size: 15px;
    color: var(--muted);
  }

  .case :global(.case-img) {
    width: 100%;
    aspect-ratio: 620 / 560;
    object-fit: cover;
    object-position: top;
    background: var(--sand);
    border-top: 1px solid var(--line);
  }

  .case-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .case-pair :global(.case-img + .case-img) {
    border-left: 1px solid var(--line);
  }

  @media (min-width: 640px) {
    .cases {
      grid-template-columns: repeat(2, 1fr);
    }

    .case--featured {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .cases {
      grid-template-columns: repeat(3, 1fr);
    }

    .case--featured {
      grid-column: auto;
    }
  }
</style>
