---
/**
 * Tour & travel packages, read from src/data/pricing.ts: the same source as
 * the main site's price list, so the ad page can never quote a different
 * price from ricksitestudio.com.
 *
 * Each button is a plain #form link (works without JS). The form script
 * listens for [data-budget] clicks and pre-selects the matching budget range.
 */
import { pricing } from '../../data/pricing';
import { PLAN_TO_BUDGET } from '../../data/landing';

const travel = pricing.find((c) => c.id === 'tour-travel');
if (!travel) throw new Error('pricing.ts: category "tour-travel" is missing');

const addonIds = ['seo', 'google-ads', 'meta-ads'] as const;
const addonLabel: Record<(typeof addonIds)[number], string> = {
  seo: 'SEO',
  'google-ads': 'Google Ads',
  'meta-ads': 'Meta Ads',
};

/** 1500000 -> "Rp 1,5 jt" */
function short(amount: number): string {
  const jt = amount / 1_000_000;
  return `Rp ${jt.toLocaleString('id-ID', { maximumFractionDigits: 1 })} jt`;
}

const addons = addonIds.map((id) => {
  const pkg = pricing.find((c) => c.id === id)?.packages[0];
  if (!pkg?.amount) throw new Error(`pricing.ts: add-on "${id}" has no amount`);
  return `${addonLabel[id]} mulai ${short(pkg.amount)}/bln`;
});

const plans = travel.packages.map((pkg) => {
  const budget = PLAN_TO_BUDGET[pkg.plan];
  if (!budget) throw new Error(`landing.ts: PLAN_TO_BUDGET has no entry for "${pkg.plan}"`);
  return { ...pkg, budget, priceShort: pkg.amount ? short(pkg.amount) : pkg.price };
});
---

<section class="lp-section lp-section--sand" aria-labelledby="pricing-title">
  <div class="lp-wrap">
    <div class="lp-head">
      <span class="lp-eyebrow">Paket harga</span>
      <h2 class="lp-h2" id="pricing-title">Harga jelas di depan, tanpa biaya tersembunyi</h2>
      <p class="lp-lead">Sekali bayar untuk pembuatan website. Pilih sesuai tahap bisnis kamu sekarang, upgrade bisa kapan saja.</p>
    </div>

    <div class="plans">
      {plans.map((plan) => (
        <article class:list={['plan', { 'plan--featured': plan.featured }]}>
          {plan.featured && <p class="plan-badge">Paling Populer</p>}
          <h3 class="plan-name">{plan.plan}</h3>
          <p class="plan-price">
            <span class="lp-sr-only">Harga </span>{plan.priceShort}
          </p>
          <p class="plan-summary">{plan.summary}</p>
          <ul class="plan-features" role="list">
            {plan.features.map((f) => (
              <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <a
            href="#form"
            class:list={['lp-btn', 'plan-btn', plan.featured ? 'lp-btn--lime' : 'lp-btn--outline']}
            data-budget={plan.budget}
            data-cta={`pricing-${plan.plan.toLowerCase()}`}
          >
            Pilih {plan.plan}
          </a>
        </article>
      ))}
    </div>

    <p class="addons">
      <strong>Add-on:</strong>
      {addons.join(' · ')}. Belum termasuk saldo iklan.
    </p>
  </div>
</section>

<style>
  .plans {
    display: grid;
    gap: 20px;
  }

  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px 24px 24px;
  }

  .plan--featured {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--on-dark);
    box-shadow: 0 20px 48px rgba(13, 13, 13, 0.18);
  }

  .plan-badge {
    position: absolute;
    top: -14px;
    left: 24px;
    padding: 4px 14px;
    border-radius: 999px;
    background: var(--lime);
    color: var(--ink);
    font-size: 13px;
    font-weight: 700;
  }

  .plan-name {
    font-size: 18px;
    font-weight: 600;
    color: var(--ink);
  }

  .plan--featured .plan-name {
    color: var(--lime);
  }

  .plan-price {
    margin-top: 6px;
    font-size: 36px;
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .plan--featured .plan-price {
    color: #fff;
  }

  .plan-summary {
    margin-top: 8px;
    font-size: 15px;
    color: var(--muted);
  }

  .plan--featured .plan-summary {
    color: var(--on-dark-muted);
  }

  .plan-features {
    list-style: none;
    padding: 20px 0 0;
    margin: 20px 0 24px;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 10px;
    flex: 1;
  }

  .plan--featured .plan-features {
    border-color: rgba(255, 255, 255, 0.14);
  }

  .plan-features li {
    display: flex;
    gap: 10px;
    font-size: 15px;
    line-height: 1.5;
  }

  .plan-features svg {
    flex: none;
    margin-top: 3px;
    color: #3f7a0a;
  }

  .plan--featured .plan-features svg {
    color: var(--lime);
  }

  .plan-btn {
    width: 100%;
  }

  .addons {
    margin-top: 28px;
    font-size: 14px;
    color: var(--muted);
    text-align: center;
  }

  .addons strong {
    color: var(--ink);
  }

  @media (min-width: 900px) {
    .plans {
      grid-template-columns: repeat(3, 1fr);
      align-items: stretch;
    }

    .plan--featured {
      transform: translateY(-12px);
    }
  }
</style>
