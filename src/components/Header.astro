---
/** Agenko header-two, transparent variant. Markup unchanged from index.html. */
import { NAV_LINKS, SOCIAL_LINKS, whatsapp } from '../data/site';
import { services, servicePath, SERVICE_PAGES_LIVE } from '../data/services';
import Logo from './Logo.astro';

// Fill the Layanan dropdown from the service catalogue so the menu and the
// services section can never list different things.
const navLinks = NAV_LINKS.map((link) =>
  link.children
    ? {
        ...link,
        children: services.map((service) => ({
          label: service.title,
          href: SERVICE_PAGES_LIVE ? servicePath(service) : '#',
        })),
      }
    : link
);

const talkLink = whatsapp('Halo Ricksite Studio, mau tanya-tanya soal project nih.');
---

<!--=== Start  Header Area  ===-->
<header class="header-area header-two transparent-header">
    <!--====  Header Navigation  ===-->
    <div class="header-navigation">
        <!--====  Header Nav Inner  ===-->
        <div class="container">
            <!--====  Primary Menu  ===-->
            <div class="primary-menu">
                <!--====  Site Branding  ===-->
                <div class="site-branding">
                    <a href="/" class="brand-logo"><Logo /></a>
                </div>
                <!--=== Sasly Main Menu===-->
                <div class="pf-nav-menu">
                    <!--====  Site Branding  ===-->
                    <div class="site-branding d-block d-lg-none text-center">
                        <a href="/" class="brand-logo"><Logo /></a>
                    </div>
                    <!--=== Main Menu ===-->
                    <nav class="main-menu">
                        <ul>
                            {navLinks.map((link) => (
                                <Fragment>
                                {link.children
                                    ? <li class="menu-item has-children">
                                          <a href={link.href}>{link.label}</a>
                                          <ul class="sub-menu">
                                              {link.children.map((child) => (
                                                  <Fragment>
                                                  <li><a href={child.href}>{child.label}</a></li>
                                                  {" "}</Fragment>
                                              ))}
                                          </ul>
                                      </li>
                                    : <li class="menu-item"><a href={link.href}>{link.label}</a></li>}
                                {" "}</Fragment>
                            ))}
                        </ul>
                    </nav>
                    <!--=== PF Nav Button ===-->
                    <div class="pf-nav-button mt-20 d-block d-md-none">
                        <a href={talkLink} target="_blank" rel="noopener" class="theme-btn style-one">
                            <span class="text-flip">
                                <span class="text">KONSULTASI</span>
                                <span class="text">KONSULTASI</span>
                            </span>
                        </a>
                    </div>
                    <!--=== PF Menu Bottom ===-->
                    <div class="pf-menu-bottom mt-50 d-block d-lg-none">
                        <h5>Ikuti Kami</h5>
                        <ul class="social-link">
                            {SOCIAL_LINKS.map((social) => (
                                <Fragment>
                                <li><a
                                    href={social.href}
                                    target="_blank"
                                    rel="noopener"
                                    aria-label={`Ricksite Studio di ${social.label}`}
                                ><i class={social.icon}></i></a></li>
                                {" "}</Fragment>
                            ))}
                        </ul>
                    </div>
                </div>
                <!--=== Header Nav Right ===-->
                <div class="nav-right-item">
                    <div class="nav-button d-none d-md-block">
                        <a href={talkLink} target="_blank" rel="noopener" class="theme-btn style-one">
                            <span class="text-flip">
                                <span class="text">KONSULTASI</span>
                                <span class="text">KONSULTASI</span>
                            </span>
                        </a>
                    </div>
                    <div class="navbar-toggler">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header><!--=== End  Header Area  ===-->
