---
/** Agenko footer. Markup unchanged from index.html. */
import { NAV_LINKS, SOCIAL_LINKS, whatsapp, WHATSAPP_DISPLAY } from '../data/site';
import { services } from '../data/services';

/** Plain wa.me link, no pre-filled message — matches the original markup. */
const talkLink = whatsapp();
---

<!--====== Start Footer Area ======-->
<footer class="agenko-footer gray-dark pt-130 primary-black-bg">
    <div class="shape shape-one"><span><img class="rotate360" src="/assets/images/digital-agency/footer/element1.png" alt="Shape"></span></div>
    <div class="shape shape-two"><span><img class="rotate360" src="/assets/images/digital-agency/footer/element2.png" alt="Shape"></span></div>
    <div class="shape shape-blur_one"><span></span></div>
    <div class="shape shape-blur_two"><span></span></div>
    <!--=== Footer Widget Area ===-->
    <div class="footer-widget-area pb-80">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-6 col-sm-6">
                    <!--=== Footer Widget ===-->
                    <div class="footer-widget footer-about-widget mb-40 pf_fadeup">
                        <div class="footer-content">
                            <div class="footer-logo">
                                <a href="index.html"><img src="/assets/images/ricksite/logo/logo-main.svg" alt="Ricksite Studio"></a>
                            </div>
                            <p>Ricksite Studio bantu bisnis bertumbuh lewat website dan digital marketing.</p>
                            <form>
                                <div class="form-group">
                                    <input type="email" class="form_control" placeholder="Alamat Email" name="email" required>
                                    <label><i class="far fa-envelope"></i></label>
                                    <button class="theme-btn style-two">Langganan</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 ">
                    <!--=== Footer Widget ===-->
                    <div class="footer-widget footer-nav-widget mb-40 pf_fadeup">
                        <div class="footer-content mb-35">
                            <h4 class="widget-title">Layanan</h4>
                            <ul class="footer-nav">
                                {services.map((service) => (
                                    <Fragment>
                                    <li>
                                        <a href="#services">{service.title}</a>
                                    </li>
                                    {" "}</Fragment>
                                ))}
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5 col-md-12">
                    <div class="row">
                        <div class="col-md-5">
                            <!--=== Footer Widget ===-->
                            <div class="footer-widget footer-nav-widget mb-40 pf_fadeup">
                                <div class="footer-content mb-35">
                                    <h4 class="widget-title">Navigasi</h4>
                                    <ul class="footer-nav">
                                        {NAV_LINKS.map((link) => (
                                            <Fragment>
                                            <li>
                                                <a href={link.href}>{link.label}</a>
                                            </li>
                                            {" "}</Fragment>
                                        ))}
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-7">
                            <!--=== Footer Widget ===-->
                            <div class="footer-widget footer-contact-widget mb-40 pf_fadeup">
                                <div class="footer-content">
                                    <h4 class="widget-title">Kontak</h4>
                                    <div class="agenko-iconic-box style-three mb-30">
                                        <div class="icon">
                                            <i class="fab fa-whatsapp"></i>
                                        </div>
                                        <div class="content">
                                            <h6>WhatsApp</h6>
                                            <p><a href={talkLink} target="_blank" rel="noopener">{WHATSAPP_DISPLAY}</a></p>
                                        </div>
                                    </div>
                                    <div class="agenko-info-box">
                                        <div class="content">
                                            <h4 class="widget-title">Ikuti Kami</h4>
                                            <div class="social-link">
                                                {SOCIAL_LINKS.map((social) => (
                                                    <Fragment>
                                                    <a href="#" data-rs-todo="social"><i class={social.icon}></i></a>
                                                    {" "}</Fragment>
                                                ))}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--=== Footer Copyright ===-->
    <div class="footer-copyright">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <!--=== Copyright Text ===-->
                    <div class="copyright-text">
                        <p>&copy; 2026 <span>Ricksite Studio</span>. Semua Hak Dilindungi.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <!--=== Copyright Nav ===-->
                    <div class="copyright-nav">
                        <ul>
                            <li><a href="#projects">Project</a></li>
                            <li><a href="#services">Layanan</a></li>
                            <li><a href="#contact">Kontak</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer><!--====== End Footer  ======-->
