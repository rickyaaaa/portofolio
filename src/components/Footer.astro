---
/** Agenko footer. Markup unchanged from index.html. */
import { NAV_LINKS, SOCIAL_LINKS, whatsapp, WHATSAPP_DISPLAY, EMAIL, EMAIL_HREF } from '../data/site';
import { services, servicePath } from '../data/services';
import { PRIVACY_URL } from '../data/landing';
import Logo from './Logo.astro';
import { asset } from '../lib/asset';

/** Plain wa.me link, no pre-filled message — matches the original markup. */
const talkLink = whatsapp();
---

<!--====== Start Footer Area ======-->
<footer class="agenko-footer gray-dark pt-130 primary-black-bg">
    <div class="shape shape-one"><span><img class="rotate360" src={asset("/assets/images/digital-agency/footer/element1.png")} alt="Shape"></span></div>
    <div class="shape shape-two"><span><img class="rotate360" src={asset("/assets/images/digital-agency/footer/element2.png")} alt="Shape"></span></div>
    <div class="shape shape-blur_one"><span></span></div>
    <div class="shape shape-blur_two"><span></span></div>
    <!--=== Footer Widget Area ===-->
    <div class="footer-widget-area pb-80">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-6 col-sm-6">
                    <!--=== Footer Widget ===-->
                    <div class="footer-widget footer-about-widget mb-40 pf_fadeup">
                        <div class="footer-content">
                            <div class="footer-logo">
                                <a href="/"><Logo /></a>
                            </div>
                            <p>Ricksite Studio bantu bisnis dapat lebih banyak customer lewat website dan iklan digital.</p>
                            <form>
                                <div class="form-group">
                                    <input type="email" class="form_control" placeholder="Alamat Email" name="email" required>
                                    <label><i class="far fa-envelope"></i></label>
                                    <button class="theme-btn style-two">Langganan</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 ">
                    <!--=== Footer Widget ===-->
                    <div class="footer-widget footer-nav-widget mb-40 pf_fadeup">
                        <div class="footer-content mb-35">
                            <p class="widget-title rs-h4">Layanan</p>
                            <ul class="footer-nav">
                                {services.map((service) => (
                                    <Fragment>
                                    <li>
                                        <a href={servicePath(service)}>{service.title}</a>
                                    </li>
                                    {" "}</Fragment>
                                ))}
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5 col-md-12">
                    <div class="row">
                        <div class="col-md-5">
                            <!--=== Footer Widget ===-->
                            <div class="footer-widget footer-nav-widget mb-40 pf_fadeup">
                                <div class="footer-content mb-35">
                                    <p class="widget-title rs-h4">Navigasi</p>
                                    <ul class="footer-nav">
                                        {NAV_LINKS.map((link) => (
                                            <Fragment>
                                            <li>
                                                <a href={link.href}>{link.label}</a>
                                            </li>
                                            {" "}</Fragment>
                                        ))}
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-7">
                            <!--=== Footer Widget ===-->
                            <div class="footer-widget footer-contact-widget mb-40 pf_fadeup">
                                <div class="footer-content">
                                    <p class="widget-title rs-h4">Kontak</p>
                                    <div class="agenko-iconic-box style-three mb-30">
                                        <div class="icon">
                                            <i class="fab fa-whatsapp"></i>
                                        </div>
                                        <div class="content">
                                            <p class="rs-h6">WhatsApp</p>
                                            <p><a href={talkLink} target="_blank" rel="noopener">{WHATSAPP_DISPLAY}</a></p>
                                        </div>
                                    </div>
                                    <div class="agenko-iconic-box style-three mb-30">
                                        <div class="icon">
                                            <i class="far fa-envelope"></i>
                                        </div>
                                        <div class="content">
                                            <p class="rs-h6">Email</p>
                                            <p><a href={EMAIL_HREF}>{EMAIL}</a></p>
                                        </div>
                                    </div>
                                    <div class="agenko-info-box">
                                        <div class="content">
                                            <p class="widget-title rs-h4">Ikuti Kami</p>
                                            <div class="social-link">
                                                {SOCIAL_LINKS.map((social) => (
                                                    <Fragment>
                                                    <a
                                                        href={social.href}
                                                        target="_blank"
                                                        rel="noopener"
                                                        aria-label={`Ricksite Studio di ${social.label}`}
                                                    ><i class={social.icon}></i></a>
                                                    {" "}</Fragment>
                                                ))}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--=== Footer Copyright ===-->
    <div class="footer-copyright">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <!--=== Copyright Text ===-->
                    <div class="copyright-text">
                        <p>&copy; 2026 <span>Ricksite Studio</span>. Semua Hak Dilindungi.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <!--=== Copyright Nav ===-->
                    <div class="copyright-nav">
                        <ul>
                            <li><a href="/projects">Project</a></li>
                            <li><a href="/#services">Layanan</a></li>
                            <li><a href="/tentang">Tentang</a></li>
                            <li><a href="/kontak">Kontak</a></li>
                            <li><a href={PRIVACY_URL} target="_blank" rel="noopener">Kebijakan Privasi</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer><!--====== End Footer  ======-->
