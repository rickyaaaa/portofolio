---
/** Agenko agk-about section, short variant (counters/experience box removed). */
import Logo from '../Logo.astro';

/**
 * The pills name what Ricksite sells, so they are read out as a list rather
 * than baked into the artwork. Order matches the brand banner they come from.
 */
const disciplines = ['Google Ads', 'Meta Ads', 'SEO', 'Website'];
---

<!--======  Start About Section  ======-->
<section class="agk-about pt-130 pb-80" id="about">
    <div class="container">
        <div class="row">
            <div class="col-xl-7">
                <!--=== Agk Content Box ===-->
                <div class="agk-content-box style-one mb-50 pf_fadeup">
                    <div class="section-title mb-20">
                        <span class="sub-title">Tentang Ricksite</span>
                        <h2>Bangun Solusi Digital
                        Sejak Hari Pertama</h2>
                    </div>
                    <p>Ricksite Studio bantu bisnis punya website, sistem custom, dan iklan digital yang beneran kepakai. Pendekatannya praktis dan fokus ke hasil, bukan teori.</p>
                <p>Buat kami website yang bagus itu diukur dari hasilnya: berapa banyak calon customer yang akhirnya chat dan jadi order.</p>
                <div class="agk-button mb-30">
                    <a href="#" data-rs-todo="about.html" class="theme-btn style-one">
                        <span class="text-flip">
                            <span class="text">TENTANG RICKSITE STUDIO</span>
                            <span class="text">TENTANG RICKSITE STUDIO</span>
                        </span>
                    </a>
                </div>
                </div>
            </div>
            <div class="col-xl-5">
                <!--=== Agk Image Box ===-->
                <div class="agk-image-box style-one mb-50 pf_fadeup">
                    <!-- Built in markup rather than shipped as an image file:
                         the wordmark is set in Poppins, and an SVG loaded
                         through <img> is an isolated document that cannot reach
                         the page's webfonts - the same reason Logo.astro is
                         inlined. This way the card stays sharp at any size and
                         the type is the real brand face. -->
                    <div class="agk-image">
                        <div class="rs-brand-card">
                            <Logo class="rs-brand-card-logo" />
                            <ul class="rs-brand-card-tags">
                                {disciplines.map((discipline, index) => (
                                    <Fragment>
                                    <li class={index === 0 ? 'is-active' : undefined}>{discipline}</li>
                                    {" "}</Fragment>
                                ))}
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section><!--======  End About Section  ======-->
