---
/**
 * Agenko agk-project section with agenko-project-item style-one cards.
 *
 * The `<Fragment>…{' '}` wrappers reproduce the newline that separated sibling
 * elements in the original hand-written HTML. That whitespace is significant:
 * the cards are inline-block siblings, so without it they sit tighter than in
 * the original.
 *
 * Where a card points is ProjectCard's decision, not this section's.
 */
import { featuredProjects } from '../../data/projects';
import ProjectCard from '../ProjectCard.astro';
---

<!--======  Start Project Section  ======-->
<section class="agk-project pt-130 pb-80" id="projects">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <!--=== Section Title ===-->
                <div class="section-title mb-60 pf_fadeup">
                    <span class="sub-title">Portofolio</span>
                    <h2>Bukan Demo Template.
                        Ini Project Client Kami.</h2>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="agk-button mb-60 float-lg-end pf_fadeup">
                    <a href="/projects" class="theme-btn style-one">
                        <span class="text-flip">
                            <span class="text">Lihat Semua Project</span>
                            <span class="text">Lihat Semua Project</span>
                        </span>
                    </a>
                </div>
            </div>
        </div>
        <div class="row">
            {featuredProjects.map((project) => (
                <Fragment>
                <ProjectCard project={project} columns="col-lg-6" />
                {" "}</Fragment>
            ))}
        </div>
    </div>
</section><!--======  End Project Section  ======-->
