---
/**
 * Agenko agk-project section with agenko-project-item style-one cards.
 *
 * The `<Fragment>…{' '}` wrappers reproduce the newline that separated sibling
 * elements in the original hand-written HTML. That whitespace is significant:
 * `.project-categories a` is inline-block, so without it the chips lose the
 * inter-word space and sit tighter than in the original.
 *
 * Cards link to the internal /projects/<slug> detail page — never straight to a
 * client's live site, and never to an internal system at all.
 */
import { featuredProjects, projectPath, PROJECT_PAGES_LIVE } from '../../data/projects';
---

<!--======  Start Project Section  ======-->
<section class="agk-project pt-130 pb-80" id="projects">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <!--=== Section Title ===-->
                <div class="section-title mb-60 pf_fadeup">
                    <span class="sub-title">Portofolio</span>
                    <h2>Bukan Demo Template.
                        Ini Project Client Kami.</h2>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="agk-button mb-60 float-lg-end pf_fadeup">
                    <a href="/projects" class="theme-btn style-one">
                        <span class="text-flip">
                            <span class="text">Lihat Semua Project</span>
                            <span class="text">Lihat Semua Project</span>
                        </span>
                    </a>
                </div>
            </div>
        </div>
        <div class="row">
            {featuredProjects.map((project) => (
                <Fragment>
                <div class="col-lg-6">
                    <!--=== Project Item ===-->
                    <div class="agenko-project-item style-one mb-45 pf_fadeup">
                        <div class="thumbnail">
                            <img src={`/assets/images/ricksite/projects/${project.image}`} alt={project.title}>
                            <div class="project-button">
                                <a
                                    href={PROJECT_PAGES_LIVE ? projectPath(project) : '#'}
                                    data-rs-todo={PROJECT_PAGES_LIVE ? undefined : projectPath(project)}
                                    aria-label={`Lihat detail project ${project.title}`}
                                ><i class="far fa-plus"></i></a>
                            </div>
                        </div>
                        <div class="content">
                            <div class="project-categories">
                                {project.tags.map((tag) => (
                                    <Fragment>
                                    <a
                                        href={PROJECT_PAGES_LIVE ? projectPath(project) : '#'}
                                        data-rs-todo={PROJECT_PAGES_LIVE ? undefined : projectPath(project)}
                                    >{tag}</a>
                                    {" "}</Fragment>
                                ))}
                            </div>
                            <h4 class="title"><a
                                href={PROJECT_PAGES_LIVE ? projectPath(project) : '#'}
                                data-rs-todo={PROJECT_PAGES_LIVE ? undefined : projectPath(project)}
                            >{project.title}</a></h4>
                        </div>
                    </div>
                </div>
                {" "}</Fragment>
            ))}
        </div>
    </div>
</section><!--======  End Project Section  ======-->
