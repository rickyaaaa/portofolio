---
/**
 * Agenko agk-services section with agenko-card-item style-one cards.
 *
 * Card markup is unchanged from the template: a three-part row of
 * [number + title] [description] [button]. Only the content is driven by data.
 */
import { services, servicePath, SERVICE_PAGES_LIVE } from '../../data/services';
---

<!--======  Start Services Section  ======-->
<section class="agk-services gray-dark pt-130 pb-100" id="services">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <!--=== Section Title ===-->
                <div class="section-title mb-65 pf_fadeup">
                    <span class="sub-title">What We Do</span>
                    <h2>Solusi Digital untuk Membantu
                        Bisnis Anda Tumbuh.</h2>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="text-box mb-60 pf_fadeup">
                    <p>Mulai dari membangun website dan sistem berbasis web hingga meningkatkan visibilitas dan mendapatkan calon pelanggan melalui digital marketing.</p>
                </div>
            </div>
        </div>
        <div class="row">
            {services.map((service) => (
                <Fragment>
                <div class="col-lg-12">
                    <!--=== Card Item ===-->
                    <div class="agenko-card-item style-one mb-30 pf_fadeup">
                        <div class="card-title">
                            <div class="sn-number">{service.number}</div>
                            <h3 class="title">{service.title}</h3>
                        </div>
                        <div class="content">
                            <p>{service.shortDescription}</p>
                        </div>
                        <div class="card-button">
                            <a
                                href={SERVICE_PAGES_LIVE ? servicePath(service) : '#'}
                                data-rs-todo={SERVICE_PAGES_LIVE ? undefined : servicePath(service)}
                                class="theme-btn style-one"
                            >
                                <span class="text-flip">
                                    <span class="text">PELAJARI SELENGKAPNYA</span>
                                    <span class="text">PELAJARI SELENGKAPNYA</span>
                                </span>
                                <span class="icon"><i class="far fa-arrow-right"></i></span>
                            </a>
                        </div>
                    </div>
                </div>
                {" "}</Fragment>
            ))}
        </div>
    </div>
</section><!--======  End Services Section  ======-->
