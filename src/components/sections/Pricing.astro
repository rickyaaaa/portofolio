---
/**
 * Price list, built from stock Agenko and Bootstrap parts.
 *
 * Lives inside each service page rather than on a page of its own, so a visitor
 * only ever sees the packages for the service they came for.
 *
 * Several categories (the website page: company profile, travel, toko online)
 * render as Bootstrap nav-tabs so they can be compared side by side. A single
 * category skips the chrome and renders its cards bare, which is what the SEO,
 * ads and web app pages get.
 *
 * Cards are `agenko-pricing-item style-three` with `check-list style-one`.
 */
import { pricing } from '../../data/pricing';
import { whatsapp } from '../../data/site';

interface Props {
  /** Show only these pricing categories. Omit to show all of them. */
  categoryIds?: string[];
  eyebrow?: string;
  heading?: string;
  intro?: string;
}

const {
  categoryIds,
  eyebrow = 'Harga',
  heading = 'Harga Jelas di Depan,<br>Tanpa Biaya Kaget.',
  intro = 'Pilih kategori yang paling cocok sama kebutuhanmu. Kalau masih bingung, isi form di bawah — kami bantu carikan yang paling masuk akal.',
} = Astro.props;

const shown = categoryIds
  ? pricing.filter((category) => categoryIds.includes(category.id))
  : pricing;

const useTabs = shown.length > 1;
---

<!--======  Start Pricing Section  ======-->
<section class="agk-pricing gray-dark pt-130 pb-100" id="harga">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <!--=== Section Title ===-->
                <div class="section-title mb-50 pf_fadeup">
                    <span class="sub-title">{eyebrow}</span>
                    <h2 set:html={heading} />
                </div>
            </div>
            <div class="col-lg-5">
                <div class="text-box mb-50 pf_fadeup">
                    <p>{intro}</p>
                </div>
            </div>
        </div>

        {useTabs && (
            <div class="row">
                <div class="col-lg-12">
                    <ul class="nav nav-tabs rs-price-tabs pf_fadeup" role="tablist">
                        {shown.map((category, index) => (
                            <Fragment>
                            <li class="nav-item" role="presentation">
                                <button
                                    class={`nav-link${index === 0 ? ' active' : ''}`}
                                    data-bs-toggle="tab"
                                    data-bs-target={`#tab-${category.id}`}
                                    type="button"
                                    role="tab"
                                    aria-selected={index === 0 ? 'true' : 'false'}
                                >{category.title}</button>
                            </li>
                            {" "}</Fragment>
                        ))}
                    </ul>
                    <div class="tab-content rs-price-tab-content">
                        {shown.map((category, index) => (
                            <Fragment>
                            <div class={`tab-pane fade${index === 0 ? ' show active' : ''}`} id={`tab-${category.id}`} role="tabpanel">
                                {category.note && <p class="rs-price-note">{category.note}</p>}
                                <div class="row">
                                    {category.packages.map((pkg) => (
                                        <Fragment>
                                        <div class={category.packages.length === 1 ? 'col-lg-6' : 'col-lg-4 col-md-6 col-sm-12'}>
                                            <div class={`agenko-pricing-item style-three mb-30${pkg.featured ? ' rs-featured' : ''}`}>
                                                <div class="shape"><span></span></div>
                                                <div class="pricing-head">
                                                    <span class="plan">{pkg.plan}</span>
                                                    <h2 class="price">{pkg.price}{pkg.period && <span class="rs-period">{pkg.period}</span>}</h2>
                                                    <p>{pkg.summary}</p>
                                                </div>
                                                <div class="pricing-body">
                                                    <ul class="check-list style-one">
                                                        {pkg.features.map((feature) => (
                                                            <Fragment>
                                                            <li><i class="flaticon-check"></i>{feature}</li>
                                                            {" "}</Fragment>
                                                        ))}
                                                    </ul>
                                                </div>
                                                <div class="pricing-footer">
                                                    <a
                                                        href={whatsapp(`Halo Ricksite Studio, saya tertarik paket ${category.title} - ${pkg.plan} (${pkg.price}${pkg.period || ''}).`)}
                                                        target="_blank"
                                                        rel="noopener"
                                                        class="theme-btn style-two"
                                                    >Tanya Paket Ini</a>
                                                </div>
                                            </div>
                                        </div>
                                        {" "}</Fragment>
                                    ))}
                                </div>
                            </div>
                            {" "}</Fragment>
                        ))}
                    </div>
                </div>
            </div>
        )}

        {!useTabs && shown.length === 1 && (
            <div class="row">
                <div class="col-lg-12">
                    {shown[0].note && <p class="rs-price-note pf_fadeup">{shown[0].note}</p>}
                </div>
                {shown[0].packages.map((pkg) => (
                    <Fragment>
                    <div class={shown[0].packages.length === 1 ? 'col-lg-6' : 'col-lg-4 col-md-6 col-sm-12'}>
                        <div class={`agenko-pricing-item style-three mb-30 pf_fadeup${pkg.featured ? ' rs-featured' : ''}`}>
                            <div class="shape"><span></span></div>
                            <div class="pricing-head">
                                <span class="plan">{pkg.plan}</span>
                                <h2 class="price">{pkg.price}{pkg.period && <span class="rs-period">{pkg.period}</span>}</h2>
                                <p>{pkg.summary}</p>
                            </div>
                            <div class="pricing-body">
                                <ul class="check-list style-one">
                                    {pkg.features.map((feature) => (
                                        <Fragment>
                                        <li><i class="flaticon-check"></i>{feature}</li>
                                        {" "}</Fragment>
                                    ))}
                                </ul>
                            </div>
                            <div class="pricing-footer">
                                <a
                                    href={whatsapp(`Halo Ricksite Studio, saya tertarik paket ${shown[0].title} - ${pkg.plan} (${pkg.price}${pkg.period || ''}).`)}
                                    target="_blank"
                                    rel="noopener"
                                    class="theme-btn style-two"
                                >Tanya Paket Ini</a>
                            </div>
                        </div>
                    </div>
                    {" "}</Fragment>
                ))}
            </div>
        )}
    </div>
</section><!--======  End Pricing Section  ======-->
