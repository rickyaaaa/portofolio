---
/**
 * Agenko hero-wrapper-two. The `.text-anm` spans are what theme.js feeds to
 * GSAP SplitText, so they must stay as two sibling spans inside the h1.
 */
import { whatsapp } from '../../data/site';
import { services } from '../../data/services';
import { asset } from '../../lib/asset';

const startLink = whatsapp('Halo Ricksite Studio, mau mulai project baru nih.');
---

<!--======  Start Hero Section  ======-->
<section class="agk-hero">
    <!--=== Hero Wrapper One ===-->
    <div class="hero-wrapper-two">
        <div class="shape shape-one"><span><img class="rotate360" src={asset("/assets/images/ricksite/shapes/shape1.svg")} alt="Shape"></span></div>
        <div class="shape shape-two"><span><img class="animate-float-bob-y" src={asset("/assets/images/ricksite/shapes/shape2.svg")} alt="Shape"></span></div>
        <div class="shape circle-one"><span></span></div>
        <div class="shape circle-two"><span></span></div>
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <!--=== Hero Content ===-->
                    <div class="hero-content">
                        <span class="sub-title">Website &bull; Web App &bull; Digital Marketing</span>
                        <h1>
                            <span class="text-anm">Website yang Bikin</span>
                            <span class="text-anm">Bisnismu Dapat Orderan.</span>
                        </h1>
                        <div class="text-box pf_fadeup">
                            <p>Kami bangun <span>website</span>, sistem custom, dan campaign iklan yang fokus ke satu hal: bikin calon customer nemu bisnismu, percaya, terus chat.</p>
                            <div class="hero-button">
                                <a href={startLink} target="_blank" rel="noopener" class="theme-btn style-one">
                                    <span class="text-flip">
                                        <span class="text">MULAI PROJECT SEKARANG</span>
                                        <span class="text">MULAI PROJECT SEKARANG</span>
                                    </span>
                                </a>
                                <a href="#projects" class="read-more style-one">Lihat Portofolio</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-4">
                    <ul class="service-list pf_fadeup">
                        {/* Teaser only - Agenko sizes this column against the hero image, and all
                            five pills leave a ~190px gap beside it. Full list is in the services section. */}
                        {services.slice(0, 4).map((service) => (
                            <Fragment>
                            <li>
                                <!--=== Iconic Box ===-->
                                <a href="#services" class="agenko-iconic-box style-one">
                                    <div class="icon">
                                        <i class={service.icon}></i>
                                    </div>
                                    <div class="content">
                                        <h4 class="title">{service.title}</h4>
                                    </div>
                                </a>
                            </li>
                            {" "}</Fragment>
                        ))}
                    </ul>
                </div>
                <div class="col-lg-8">
                    <!--=== Hero Image Box ===-->
                    <div class="hero-image style-one pf_fadeup">
                        <img src={asset("/assets/images/ricksite/pages/hero-img1.svg")} alt="Hero Image">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section><!--======  End Hero Section  ======-->
