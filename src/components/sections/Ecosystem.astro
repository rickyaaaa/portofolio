---
/**
 * Agenko agk-who-we section. The `.text-anm-two` heading is animated by
 * theme.js, which splits it per character on a repeating timeline.
 */
import { ecosystemPoints } from '../../data/content';
---

<!--======  Start Who We Section  ======-->
<section class="agk-who-we pt-130 pb-70">
    <div class="container">
        <div class="row">
            <div class="col-xl-5">
                <!--=== Agk Content Box ===-->
                <div class="agk-content-box mb-50 pf_fadeup">
                    <div class="section-title mb-30">
                        <span class="sub-title">Lebih dari Sekadar Website</span>
                        <h2>Website Bagus Itu Baru Langkah Awal</h2>
                    </div>
                    <ul class="check-list style-one mb-40">
                        {ecosystemPoints.map((point) => (
                            <Fragment>
                            <li><i class="flaticon-check"></i>{point}</li>
                            {" "}</Fragment>
                        ))}
                    </ul>
                    <div class="agk-button">
                        <a href="#contact" class="theme-btn style-one">
                            <span class="text-flip">
                                <span class="text">SELENGKAPNYA</span>
                                <span class="text">SELENGKAPNYA</span>
                            </span>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-xl-7">
                <!--=== Agk Image Box ===-->
                <div class="agk-play-image-box mb-50 pf_fadeup">
                    <div class="agk-image style-four">
                        <img src="/assets/images/ricksite/pages/who1.svg" class="rounded-2" alt="Features">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <!--=== Big Text ===-->
            <div class="big-text text-center mt-80 pt-70">
                <h2 class="text-anm-two">WEBSITE + MARKETING</h2>
            </div>
        </div>
    </div>
</section><!--======  End Who We Section  ======-->
