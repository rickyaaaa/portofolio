# Ricksite Studio - server rules for the static Astro build.
#
# The build uses Astro's `format: 'file'`, so every page is a flat .html file
# (jasa-seo.html) while every link in the markup is extensionless (/jasa-seo).
# Without the rewrite below, LiteSpeed answers those links with a 404. This
# file is the piece that makes the two halves agree.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # One canonical origin: https, no www. Anything else redirects once.
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://ricksitestudio.com%{REQUEST_URI} [R=301,L,NE]

    # Google's site-verification file has to answer at its exact URL with a
    # 200: the check treats a redirect as a failure. The .html rule below would
    # strip its extension like any other page, so it is served untouched here,
    # before anything can rewrite it. The pattern covers re-verification with a
    # new token rather than just today's file.
    RewriteRule ^google[0-9a-f]{16}\.html$ - [L]

    # /sitemap.xml is what people and tools reach for by habit; the generated
    # index is sitemap-index.xml. Pointing one at the other means submitting
    # the wrong one in Search Console still finds it.
    RewriteRule ^sitemap\.xml$ /sitemap-index.xml [R=301,L]

    # /404 is the error document's own path, not a page of this site. The
    # extensionless rule at the bottom would happily serve it at 200, and a
    # page that says "not found" while returning 200 is the soft 404 Search
    # Console reports. Answer with a real 404 instead - Apache then renders
    # the same page through ErrorDocument, with the status it should have had.
    # The ErrorDocument path is /404.html, which this pattern does not match,
    # so there is no loop.
    RewriteRule ^404$ - [R=404,L]

    # /index.html is the homepage; send it to / before the generic rule below
    # can turn it into /index.
    RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
    RewriteRule ^ / [R=301,L]

    # A visitor should never see the .html extension, so requests that spell it
    # out are redirected to the extensionless form the site actually links to.
    RewriteCond %{THE_REQUEST} \s/+([^\s?]*?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # Drop a trailing slash on anything that is not a real directory, so
    # /jasa-seo/ and /jasa-seo do not become two URLs for one page.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

    # The rewrite itself: /jasa-seo is served from jasa-seo.html, internally and
    # with a 200. No redirect, so there is no extra round trip on every click.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ /$1.html [L]
</IfModule>

ErrorDocument 404 /404.html

# Dotfiles are never part of the site.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On

    # Every stylesheet, script and image is requested with a ?v=<content hash>
    # that src/lib/asset.ts puts on the URL, so an edited file is a new URL and
    # a year of caching cannot serve a stale one. Without that the CDN in front
    # of this host kept answering with an old stylesheet for hours after a
    # deploy, and an overwritten image would have been worse - a year.
    #
    # Fonts are the exception: they are referenced from inside the CSS, which
    # this cannot rewrite. They are also the files nobody edits.
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType application/font-woff     "access plus 1 year"
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
