---
/** Agenko header-two, transparent variant. Markup unchanged from index.html. */
import { NAV_LINKS, SOCIAL_LINKS, whatsapp } from '../data/site';

const talkLink = whatsapp('Halo Ricksite Studio, mau tanya-tanya soal project nih.');
---

<!--=== Start  Header Area  ===-->
<header class="header-area header-two transparent-header">
    <!--====  Header Navigation  ===-->
    <div class="header-navigation">
        <!--====  Header Nav Inner  ===-->
        <div class="container">
            <!--====  Primary Menu  ===-->
            <div class="primary-menu">
                <!--====  Site Branding  ===-->
                <div class="site-branding">
                    <a href="index.html" class="brand-logo"><img src="/assets/images/ricksite/logo/logo-main.svg" alt="Ricksite Studio"></a>
                </div>
                <!--=== Sasly Main Menu===-->
                <div class="pf-nav-menu">
                    <!--====  Site Branding  ===-->
                    <div class="site-branding d-block d-lg-none text-center">
                        <a href="index.html" class="brand-logo"><img src="/assets/images/ricksite/logo/logo-main.svg" alt="Ricksite Studio"></a>
                    </div>
                    <!--=== Main Menu ===-->
                    <nav class="main-menu">
                        <ul>
                            {NAV_LINKS.map((link) => (
                                <Fragment>
                                <li class="menu-item"><a href={link.href}>{link.label}</a></li>
                                {" "}</Fragment>
                            ))}
                        </ul>
                    </nav>
                    <!--=== PF Nav Button ===-->
                    <div class="pf-nav-button mt-20 d-block d-md-none">
                        <a href={talkLink} target="_blank" rel="noopener" class="theme-btn style-one">
                            <span class="text-flip">
                                <span class="text">NGOBROL YUK</span>
                                <span class="text">NGOBROL YUK</span>
                            </span>
                        </a>
                    </div>
                    <!--=== PF Menu Bottom ===-->
                    <div class="pf-menu-bottom mt-50 d-block d-lg-none">
                        <h5>Ikuti Kami</h5>
                        <ul class="social-link">
                            {SOCIAL_LINKS.map((social) => (
                                <Fragment>
                                <li><a href="#" data-rs-todo="social"><i class={social.icon}></i></a></li>
                                {" "}</Fragment>
                            ))}
                        </ul>
                    </div>
                </div>
                <!--=== Header Nav Right ===-->
                <div class="nav-right-item">
                    <div class="nav-button d-none d-md-block">
                        <a href={talkLink} target="_blank" rel="noopener" class="theme-btn style-one">
                            <span class="text-flip">
                                <span class="text">NGOBROL YUK</span>
                                <span class="text">NGOBROL YUK</span>
                            </span>
                        </a>
                    </div>
                    <div class="navbar-toggler">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header><!--=== End  Header Area  ===-->
